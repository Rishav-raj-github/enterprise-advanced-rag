# ==============================================================================
# Enterprise Advanced RAG - Environment Configuration
# ==============================================================================

# LLM Providers (Gemini is recommended and configured as default)
GOOGLE_API_KEY=your_gemini_api_key_here

# Web Search integration (Used as fallback in Corrective RAG)
TAVILY_API_KEY=your_tavily_api_key_here

# System Configurations
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
SEMANTIC_CACHE_THRESHOLD=0.92

# SQLite Settings
SQL_DB_PATH=data/business_metrics.db
VECTOR_DB_DIR=data/vector_db

# Logging & Debugging
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enterprise-advanced-rag
